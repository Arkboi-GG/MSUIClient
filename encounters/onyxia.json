  "phases": [
    {
      "key": "p1",
      "name": "Phase 1 — ground",
      "casterFlying": false,
      "meleeEnabled": true,
      "note": "Ground tank-and-spank. She lands here from the start and never leaves until 65%.",
      "transitions": [
        {
          "toPhase": "p2",
          "trigger": { "kind": "HealthBelow", "threshold": 0.65 },
          "fidelity": "DeclaredCppManifest",
          "note": "boss_onyxia.cpp UpdateAI: GetHealthPercent() < 65.0f && m_uiPhase == PHASE_ONE. The takeoff below is PhaseTransition()'s ordered beats — this choreography is exactly what EventAI cannot express today and the reason phase transitions own a step list.",
          "sources": [
            { "kind": "cpp", "location": "boss_onyxia.cpp:boss_onyxiaAI::UpdateAI", "detail": "phase gate" },
            { "kind": "cpp", "location": "boss_onyxia.cpp:boss_onyxiaAI::PhaseTransition", "detail": "PHASE_TWO branch" }
          ],
          "steps": [
            { "kind": "Say", "note": "Onyxia says: This meaningless exertion bores me. I'll incinerate your remains!" },
            { "kind": "SetSpeed", "value": 9.0, "note": "ONYXIA_NORMAL_SPEED 1.28571 x 7.0 base run" },
            { "kind": "MoveTo", "point": [-57.750641, -215.610077, -85.094727], "note": "DEPART_FLIGHT waypoint, MOVE_PATHFINDING" },
            { "kind": "Wait", "durationMs": 1000, "note": "MovementInform(DEPART_FLIGHT) sets orientation 0 then waits 1000" },
            { "kind": "SetFlying", "flag": true, "note": "SetFly + SetLevitate + EMOTE_ONESHOT_LIFTOFF" },
            { "kind": "MoveTo", "point": [-57.204933, -215.592148, -85.156929], "flag": true },
            { "kind": "Wait", "durationMs": 2000 },
            { "kind": "Cast", "spellId": 17131, "note": "SPELL_HOVER — the aura the script uses as its own is-flying test" },
            { "kind": "MoveTo", "point": [22.8763, -217.152, -65.0548], "flag": true, "note": "m_uiMovePoint starts at 7 (North)" }
          ]
        }
      ]
    },
    {
      "key": "p2",
      "name": "Phase 2 — air",
      "casterFlying": true,
      "meleeEnabled": false,
      "note": "Circles eight fixed waypoints at z=-65, ~22 yd above the floor. GAP-5: the ring walk (35% clockwise / 35% counter-clockwise / 30% opposite-with-breath) is a stateful graph traversal the format cannot express, so the flight below is a representative loop, not the real selection.",
      "transitions": [
        {
          "toPhase": "p3",
          "trigger": { "kind": "HealthBelow", "threshold": 0.4 },
          "fidelity": "DeclaredCppManifest",
          "note": "GetHealthPercent() < 40 && PHASE_TWO && !IsMoving() && !m_bDeepBreathIsCasting. GAP-7: the real landing point branches on GetPositionX() < -40 (south pad vs north pad); the format has no conditional step, so the north pad is hard-coded here.",
          "sources": [
            { "kind": "cpp", "location": "boss_onyxia.cpp:boss_onyxiaAI::PhaseTransition", "detail": "PHASE_THREE branch" }
          ],
          "steps": [
            { "kind": "Say", "note": "Onyxia says: It seems you'll need another lesson, mortals!" },
            { "kind": "Unmodeled", "note": "GAP-4: DoResetThreat() — no threat model exists in the simulator" },
            { "kind": "SetSpeed", "value": 9.0 },
            { "kind": "MoveTo", "point": [-8.86, -212.752, -88.542], "flag": true, "note": "LANDING_FLIGHT north pad; south pad is [-59.895,-214.876,-84.855] when x < -40" },
            { "kind": "Wait", "durationMs": 1000 },
            { "kind": "SetFlying", "flag": false, "note": "EMOTE_ONESHOT_LAND" },
            { "kind": "Cast", "spellId": 18431, "note": "Bellowing Roar fires immediately on landing" },
            { "kind": "MoveTo", "point": [-8.86, -212.752, -87.482] },
            { "kind": "Wait", "durationMs": 2000 }
          ]
        }
      ],
      "onEnter": [
        { "kind": "SetSpeed", "value": 9.0 }
      ]
    },
    {
      "key": "p3",
      "name": "Phase 3 — ground + roar",
      "casterFlying": false,
      "meleeEnabled": true,
      "note": "PhaseThree() calls PhaseOne() at its end, so every Phase 1 ability is live again alongside Bellowing Roar and the trickle of whelps."
    }
  ],

